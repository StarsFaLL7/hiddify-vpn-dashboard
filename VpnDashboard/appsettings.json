{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=vpndashboard.db"
  },
  "Admin": {
    "SecretPathSegment1": "",
    "SecretPathSegment2": "",
    "PasswordHash": "",
    "PasswordSalt": ""
  },
  "Ping": {
    "IntervalMinutes": 5,
    "TimeoutSeconds": 8,
    "Enabled": true
  },
  "Probe": {
    "Enabled": true,
    "IntervalMinutes": 180,
    "StartupDelaySeconds": 60,
    "Concurrency": 4,
    "ConnectTimeoutSeconds": 5,
    "XrayEnabled": true,
    "XrayPath": "xray",
    "XrayTimeoutSeconds": 12,
    "ProbeUrl": "http://cp.cloudflare.com/generate_204",
    "FilterEnabled": true,
    "FailureThreshold": 3,
    "MaxDropFraction": 0.5,
    "ForgetAfterDays": 14
  },
  "Aggregation": {
    "Enabled": true,
    "CacheTtlMinutes": 10,
    "FetchTimeoutSeconds": 15,
    "UserAgent": "Happ/3.13.0",
    "DeviceOs": "Android",
    "DeviceOsVersion": "14",
    "DeviceModel": "Pixel 7",
    "DeviceLocale": "ru_RU",
    "ProfileTitle": "",
    "ProfileTitlePrefix": "Prism-X | ",
    "UpdateIntervalHours": 12,
    "SortOrder": "ping",
    "ExpireDays": 9999,
    "SupportUrl": "",
    "ExcludeNameContains": [],
    "GroupInsertAfter": 20,
    "GroupRules": [
      {
        "Name": "\uD83C\uDDF7\uD83C\uDDFA🛰️ Обход белых списков",
        "MatchContains": [ "LTE", "Обход", "белые", "белых", "списк" ],
        "Slug": "bypass",
        "ShortName": "Обход БС"
      }
    ],
    "DirectSlug": "direct",
    "DirectTitle": "Только прямые серверы",
    "DirectShortName": "Прямые",
    "VariantTitleSeparator": " · ",
    "DeepLinks": {
      "INCY": "incy://import/{url}",
      "Happ": "happ://add/{url}",
      "Hiddify": "hiddify://import/{url}"
    }
  },
  "AllowedHosts": "*"
}

@page "/global-subscriptions"
@inject SubscriptionService SubscriptionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Общие подписки</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Общие подписки</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
               OnClick="AddSub">Добавить подписку</MudButton>
</MudStack>

<MudTable Items="_subs" Loading="_loading" Hover Bordered Dense>
    <HeaderContent>
        <MudTh>Подпись</MudTh>
        <MudTh>Префикс</MudTh>
        <MudTh>URL</MudTh>
        <MudTh>Состояние</MudTh>
        <MudTh>Назначена</MudTh>
        <MudTh>Включена</MudTh>
        <MudTh Style="text-align:right">Действия</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Подпись">@context.Label</MudTd>
        <MudTd DataLabel="Префикс">@(context.Prefix ?? "—")</MudTd>
        <MudTd DataLabel="URL"><span class="url-cell">@context.Url</span></MudTd>
        <MudTd DataLabel="Состояние">
            @if (!_states.TryGetValue(context.Id, out var state))
            {
                <MudTooltip Text="За подпиской ещё не ходили: её не запрашивал ни один клиент">
                    <MudChip T="string" Size="Size.Small">нет данных</MudChip>
                </MudTooltip>
            }
            else
            {
                @if (state.LastAttemptFailed)
                {
                    <MudTooltip Text="@state.LastError">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">ошибка</MudChip>
                    </MudTooltip>
                }
                else
                {
                    @* Замечание при удачном ответе — провайдер прислал записи, которые не удалось опознать. *@
                    <MudTooltip Text="@state.LastError" Disabled="@(state.LastError is null)">
                        <MudChip T="string" Color="@(state.LastError is null ? Color.Success : Color.Warning)" Size="Size.Small">
                            @state.ConfigCount серв.
                        </MudChip>
                    </MudTooltip>
                }
                @if (state.FetchedAt is { } fetchedAt)
                {
                    <MudTooltip Text="@fetchedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(state.LastAttemptFailed ? $"снимок на {state.ConfigCount} серв., {Ago(fetchedAt)}" : Ago(fetchedAt))
                        </MudText>
                    </MudTooltip>
                }
            }
        </MudTd>
        <MudTd DataLabel="Назначена">
            @(context.Assignments.Count) польз.
            @if (context.AssignToNewUsers)
            {
                <MudTooltip Text="Назначается каждому новому пользователю">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" Class="ml-1"
                             Style="vertical-align:middle" />
                </MudTooltip>
            }
        </MudTd>
        <MudTd DataLabel="Включена">
            <MudSwitch T="bool" Value="context.IsEnabled" Color="Color.Primary"
                       ValueChanged="@(v => ToggleEnabled(context, v))" />
        </MudTd>
        <MudTd Style="text-align:right">
            <MudTooltip Text="Выше">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                               Disabled="@(_subs.IndexOf(context) == 0)"
                               OnClick="@(() => MoveSub(context, -1))" />
            </MudTooltip>
            <MudTooltip Text="Ниже">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                               Disabled="@(_subs.IndexOf(context) == _subs.Count - 1)"
                               OnClick="@(() => MoveSub(context, 1))" />
            </MudTooltip>
            <MudTooltip Text="Кому включено">
                <MudIconButton Icon="@Icons.Material.Filled.People" Size="Size.Small"
                               OnClick="@(() => AssignSub(context))" />
            </MudTooltip>
            <MudTooltip Text="Редактировать">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditSub(context))" />
            </MudTooltip>
            <MudTooltip Text="Удалить">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteSub(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Общие подписки ещё не созданы.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<GlobalSubscription> _subs = [];
    private Dictionary<Guid, GlobalSourceState> _states = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _subs = await SubscriptionService.GetAllGlobalAsync();
        _states = await SubscriptionService.GetGlobalStatesAsync();
        _loading = false;
    }

    /// <summary>Давность события словами; точное время — в подсказке.</summary>
    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        return span switch
        {
            { TotalMinutes: < 1 } => "только что",
            { TotalHours: < 1 } => $"{(int)span.TotalMinutes} мин назад",
            { TotalDays: < 1 } => $"{(int)span.TotalHours} ч назад",
            _ => $"{(int)span.TotalDays} дн назад"
        };
    }

    private async Task AddSub()
    {
        var dialog = await DialogService.ShowAsync<SubscriptionEditDialog>("Новая общая подписка");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: SubscriptionEditDialog.Result data })
        {
            await SubscriptionService.CreateGlobalAsync(data.Label, data.Url, data.Prefix, data.UserAgent);
            Snackbar.Add("Подписка добавлена", Severity.Success);
            await Reload();
        }
    }

    private async Task EditSub(GlobalSubscription sub)
    {
        var parameters = new DialogParameters
        {
            ["Label"] = sub.Label,
            ["Url"] = sub.Url,
            ["Prefix"] = sub.Prefix,
            ["UserAgent"] = sub.UpstreamUserAgent
        };
        var dialog = await DialogService.ShowAsync<SubscriptionEditDialog>("Редактирование", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: SubscriptionEditDialog.Result data })
        {
            await SubscriptionService.UpdateGlobalAsync(
                sub.Id, data.Label, data.Url, sub.IsEnabled, data.Prefix, data.UserAgent);
            Snackbar.Add("Сохранено", Severity.Success);
            await Reload();
        }
    }

    private async Task ToggleEnabled(GlobalSubscription sub, bool enabled)
    {
        await SubscriptionService.UpdateGlobalAsync(
            sub.Id, sub.Label, sub.Url, enabled, sub.Prefix, sub.UpstreamUserAgent);
        sub.IsEnabled = enabled;
    }

    private async Task MoveSub(GlobalSubscription sub, int delta)
    {
        await SubscriptionService.MoveGlobalAsync(sub.Id, delta);
        await Reload();
    }

    private async Task AssignSub(GlobalSubscription sub)
    {
        var parameters = new DialogParameters
        {
            ["GlobalSubscriptionId"] = sub.Id,
            ["AssignToNewUsers"] = sub.AssignToNewUsers
        };
        var dialog = await DialogService.ShowAsync<GlobalSubAssignDialog>($"Кому включено: {sub.Label}", parameters);
        await dialog.Result;
        await Reload();
    }

    private async Task DeleteSub(GlobalSubscription sub)
    {
        var parameters = new DialogParameters { ["Message"] = $"Удалить общую подписку «{sub.Label}»?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await SubscriptionService.DeleteGlobalAsync(sub.Id);
            Snackbar.Add("Удалено", Severity.Info);
            await Reload();
        }
    }
}

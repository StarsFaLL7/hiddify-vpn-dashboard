@page "/"
@inject UserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Пользователи</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Пользователи</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Variant="Variant.Filled"
               OnClick="AddUser">Новый пользователь</MudButton>
</MudStack>

<MudTable Items="_users" Loading="_loading" Hover Bordered Dense Filter="Matches">
    <ToolBarContent>
        <MudTextField @bind-Value="_search" Placeholder="Поиск по имени и комментарию" Immediate Clearable
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<LocalUser, object>(u => u.Name)"
                               InitialDirection="SortDirection.Ascending">Имя</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<LocalUser, object>(u => ServerCount(u))">Серверы</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<LocalUser, object>(u => SubscriptionCount(u))">Подписки</MudTableSortLabel>
        </MudTh>
        <MudTh>Комментарий</MudTh>
        <MudTh>
            @* Ни разу не обновлявшие идут как самые давние. *@
            <MudTableSortLabel SortBy="new Func<LocalUser, object>(u => u.LastSubscriptionFetchAt ?? DateTime.MinValue)">
                Обновлял подписку
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<LocalUser, object>(u => u.CreatedAt)">Создан</MudTableSortLabel>
        </MudTh>
        <MudTh Style="text-align:right">Действия</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Имя">@context.Name</MudTd>
        <MudTd DataLabel="Серверы">
            <MudTooltip Disabled="@(context.Bindings.Count == 0)">
                <ChildContent>
                    <MudChip T="string" Size="Size.Small" Color="@(ServerCount(context) > 0 ? Color.Success : Color.Default)">
                        @ServerCount(context)
                    </MudChip>
                </ChildContent>
                <TooltipContent>
                    @foreach (var line in ServerLines(context))
                    {
                        <div>@line</div>
                    }
                </TooltipContent>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Подписки">
            <MudTooltip Disabled="@(context.GlobalSubscriptions.Count == 0)">
                <ChildContent>
                    <MudChip T="string" Size="Size.Small" Color="@(SubscriptionCount(context) > 0 ? Color.Success : Color.Default)">
                        @SubscriptionCount(context)
                    </MudChip>
                </ChildContent>
                <TooltipContent>
                    @foreach (var line in SubscriptionLines(context))
                    {
                        <div>@line</div>
                    }
                </TooltipContent>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Комментарий">@context.Comment</MudTd>
        <MudTd DataLabel="Обновлял подписку">
            @if (context.LastSubscriptionFetchAt is { } fetchedAt)
            {
                <MudTooltip Text="@fetchedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")">
                    <span>@Ago(fetchedAt)</span>
                </MudTooltip>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">ни разу</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Создан">@context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</MudTd>
        <MudTd Style="text-align:right">
            <MudTooltip Text="Копировать ссылку витрины">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                               OnClick="@(() => CopyLink(context))" />
            </MudTooltip>
            <MudTooltip Text="Редактировать">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditUser(context))" />
            </MudTooltip>
            <MudTooltip Text="Удалить">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteUser(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Пользователи ещё не созданы.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<LocalUser> _users = [];
    private bool _loading = true;
    private string? _search;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _users = await UserService.GetAllAsync();
        _loading = false;
    }

    private static int ServerCount(LocalUser u) => u.Bindings.Count(b => b is { IsEnabled: true, IsBroken: false });

    /// <summary>Общие подписки, которые пользователь реально получает: назначенные и не выключенные глобально.</summary>
    private static int SubscriptionCount(LocalUser u) => u.GlobalSubscriptions.Count(x => x.GlobalSubscription.IsEnabled);

    /// <summary>Все привязки пользователя для подсказки; не попавшие в счётчик — с причиной.</summary>
    private static IEnumerable<string> ServerLines(LocalUser u) =>
        u.Bindings
            .OrderBy(b => b.HiddifyServer.Name)
            .Select(b => b.HiddifyServer.Name + (b.IsBroken ? " — сломана" : b.IsEnabled ? "" : " — выключена"));

    /// <summary>Все назначенные общие подписки для подсказки; не попавшие в счётчик — с причиной.</summary>
    private static IEnumerable<string> SubscriptionLines(LocalUser u) =>
        u.GlobalSubscriptions
            .OrderBy(x => x.GlobalSubscription.Position)
            .Select(x => x.GlobalSubscription.Label + (x.GlobalSubscription.IsEnabled ? "" : " — выключена глобально"));

    private bool Matches(LocalUser u) =>
        string.IsNullOrWhiteSpace(_search) ||
        u.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
        (u.Comment?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    /// <summary>Давность события словами; точное время — в подсказке.</summary>
    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        return span switch
        {
            { TotalMinutes: < 1 } => "только что",
            { TotalHours: < 1 } => $"{(int)span.TotalMinutes} мин назад",
            { TotalDays: < 1 } => $"{(int)span.TotalHours} ч назад",
            { TotalDays: < 30 } => $"{(int)span.TotalDays} дн назад",
            _ => utc.ToLocalTime().ToString("dd.MM.yyyy")
        };
    }

    private string ShowcaseUrl(LocalUser u)
    {
        // Витрина живёт на реальном корне (вне секретного префикса админки).
        var authority = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
        return $"{authority}/u/{u.ShowcaseToken}";
    }

    private async Task CopyLink(LocalUser u)
    {
        var ok = await JS.InvokeAsync<bool>("vpnCopy", ShowcaseUrl(u));
        Snackbar.Add(ok ? "Ссылка скопирована" : "Не удалось скопировать", ok ? Severity.Success : Severity.Error);
    }

    private async Task AddUser()
    {
        var dialog = await DialogService.ShowAsync<UserCreateDialog>("Новый пользователь");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ValueTuple<string, string?> data })
        {
            await UserService.CreateAsync(data.Item1, data.Item2);
            Snackbar.Add("Пользователь создан", Severity.Success);
            await Reload();
        }
    }

    private async Task EditUser(LocalUser u)
    {
        var parameters = new DialogParameters { ["UserId"] = u.Id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UserEditDialog>($"Пользователь: {u.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: true })
            await Reload();
    }

    private async Task DeleteUser(LocalUser u)
    {
        var parameters = new DialogParameters { ["Message"] = $"Удалить пользователя «{u.Name}»? Все привязки и подписки будут удалены." };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await UserService.DeleteAsync(u.Id);
            Snackbar.Add("Пользователь удалён", Severity.Info);
            await Reload();
        }
    }
}
